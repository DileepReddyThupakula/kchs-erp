# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# separate build folder for preview servers
/.next-preview/
/.next-build/

# generated / local-only files (never commit)
/design-preview/
/uploads/
/test-results/
/playwright-report/
*.log
*.pdf
*.xlsx
*.xls
*.csv
*.dump
*.bak
.scratch/

# backups and keys: NEVER commit (they hold children's data / the master key). The scripts write to ~/KCHS-Backups, outside the repo; these lines are a second lock.
/KCHS-Backups/
/KCHS-Backup-Keys/
/backups/
/backup-keys/
*.enc
*.enc.partial
*.enc.sha256
*.pem
*.p12
*.pfx
*.age
