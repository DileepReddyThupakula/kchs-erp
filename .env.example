# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create staff logins and by seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for tests and seed scripts
# (Dashboard → Connect → Session pooler). Includes the DB password.
DATABASE_URL=

# Password given to the demo logins created by `npm run seed:demo`
DEMO_USER_PASSWORD=

# Automatic Telugu translation (server only; optional: without it the office types the Telugu).
# TRANSLATION_PROVIDER = gemini | azure | google   (empty = gemini if its key is set, else azure, else google)
TRANSLATION_PROVIDER=gemini
# Gemini (default): API key from Google AI Studio; primary model, and one retry on the fallback model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
#
# Azure Translator (resource key and its region, e.g. centralindia)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# optional: only if your resource uses a custom endpoint (default https://api.cognitive.microsofttranslator.com)
AZURE_TRANSLATOR_ENDPOINT=
# Google Cloud Translation (alternative; API key with the Cloud Translation API enabled)
GOOGLE_TRANSLATE_API_KEY=

# Server-only secret for the failed sign-in keys (keyed hash of the login ID). Make a long random value; use a DIFFERENT one for production.
LOGIN_KEY_SECRET=
