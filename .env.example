# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create staff logins and by seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for tests and seed scripts
# (Dashboard → Connect → Session pooler). Includes the DB password.
DATABASE_URL=

# Password given to the demo logins created by `npm run seed:demo`
DEMO_USER_PASSWORD=

# Automatic Telugu translation (server only; optional: without it the office types the Telugu).
# TRANSLATION_PROVIDER = azure | google   (empty = whichever key below is filled in)
TRANSLATION_PROVIDER=
# Azure Translator (resource key and its region, e.g. centralindia)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# optional: only if your resource uses a custom endpoint (default https://api.cognitive.microsofttranslator.com)
AZURE_TRANSLATOR_ENDPOINT=
# Google Cloud Translation (alternative; API key with the Cloud Translation API enabled)
GOOGLE_TRANSLATE_API_KEY=
