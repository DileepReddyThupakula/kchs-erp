# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create staff logins and by seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for tests and seed scripts
# (Dashboard → Connect → Session pooler). Includes the DB password.
DATABASE_URL=

# Password given to the demo logins created by `npm run seed:demo`
DEMO_USER_PASSWORD=
