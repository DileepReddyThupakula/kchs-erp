{
  "name": "kchs-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node --env-file-if-exists=.env.local scripts/test-db.mjs",
    "seed:school": "node --env-file-if-exists=.env.local scripts/seed-school.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "seed:wipe": "node --env-file-if-exists=.env.local scripts/wipe-demo.mjs",
    "typecheck": "tsc --noEmit",
    "brand:icons": "node scripts/brand-icons.mjs",
    "brand:set-logo": "node --env-file-if-exists=.env.local scripts/set-logo.mjs",
    "db:apply": "node --env-file-if-exists=.env.local scripts/apply-migration.mjs",
    "seed:demo-students": "node --env-file-if-exists=.env.local scripts/demo-students.mjs seed",
    "wipe:demo-students": "node --env-file-if-exists=.env.local scripts/demo-students.mjs wipe",
    "seed:demo-fees": "node --env-file-if-exists=.env.local scripts/demo-fees.mjs seed",
    "seed:demo-timetable": "node --env-file-if-exists=.env.local scripts/demo-timetable.mjs seed",
    "wipe:demo-timetable": "node --env-file-if-exists=.env.local scripts/demo-timetable.mjs wipe",
    "wipe:demo-fees": "node --env-file-if-exists=.env.local scripts/demo-fees.mjs wipe",
    "test:ui": "vitest run",
    "test": "npm run test:db && npm run test:ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
